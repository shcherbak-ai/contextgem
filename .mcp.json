{
  "mcpServers": {
    "playwright": {
      "command": "node",
      "args": [
        "node_modules/@playwright/mcp/cli.js",
        "--headless",
        "--isolated",
        "--allowed-origins",
        "http://localhost:*;http://127.0.0.1:*;https://camo.githubusercontent.com"
      ]
    }
  }
}
