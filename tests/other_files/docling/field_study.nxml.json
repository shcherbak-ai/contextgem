      "content_layer": "body",
      "label": "section_header",
      "prov": [],
      "orig": "Introduction",
      "text": "Introduction",
      "level": 1
    },
    {
      "self_ref": "#/texts/6",
      "parent": {
        "$ref": "#/texts/5"
      },
      "children": [],
      "content_layer": "body",
      "label": "text",
      "prov": [],
      "orig": "Irrigation accounts for most of the fresh water withdrawn in the study region, and the allocations to farms were cut in 2023. Deficit irrigation, which supplies less water than the crop uses, has kept yields of other crops close to those of full irrigation [1].",
      "text": "Irrigation accounts for most of the fresh water withdrawn in the study region, and the allocations to farms were cut in 2023. Deficit irrigation, which supplies less water than the crop uses, has kept yields of other crops close to those of full irrigation [1]."
    },
